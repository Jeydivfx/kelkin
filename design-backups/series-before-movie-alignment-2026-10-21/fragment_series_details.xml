<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_catalog_page" android:layoutDirection="rtl">
  <com.example.kelkin.DetailBackdropView android:id="@+id/imgBackdrop" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" tools:src="@drawable/hero_test_header" />
  <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layoutDirection="rtl" android:paddingStart="56dp" android:paddingEnd="56dp" android:id="@+id/detail_content" android:paddingTop="44dp" android:paddingBottom="8dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="80dp" android:layoutDirection="rtl" android:gravity="right">
        <LinearLayout android:layout_width="match_parent" android:layout_height="86dp" android:orientation="vertical" android:gravity="right|top" android:layoutDirection="rtl">
          <TextView android:id="@+id/txtTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="@color/text_white" android:textSize="30sp" android:textStyle="bold" tools:text="نام سریال" android:fontFamily="@font/yekanbakh_bold" android:maxLines="2" android:ellipsize="end" android:textDirection="rtl" android:gravity="right" />
          <TextView android:id="@+id/txtTitleEnglish" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:fontFamily="@font/montserrat_regular" android:textColor="@color/english_title_color" android:textSize="12sp" android:alpha="0.8" tools:text="Series Original Title" android:maxLines="1" android:textDirection="ltr" android:layout_gravity="right" android:gravity="right" />
        </LinearLayout>
        <LinearLayout android:id="@+id/movie_info_row" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp" android:gravity="right|center_vertical" android:layoutDirection="rtl" android:layout_gravity="right">
          <TextView android:id="@+id/txtRating" android:layout_width="wrap_content" android:layout_height="22dp" android:layout_marginStart="0dp" android:gravity="right|center_vertical" android:paddingHorizontal="0dp" android:background="@android:color/transparent" android:fontFamily="@font/vazir_regular" android:textColor="@color/text_white" android:textSize="12sp" tools:text="IMDB ۷.۳" android:includeFontPadding="false" android:minWidth="0dp" android:layout_marginEnd="12dp" />
          <TextView android:id="@+id/txtQuality" android:layout_width="wrap_content" android:layout_height="22dp" android:layout_marginStart="0dp" android:gravity="right|center_vertical" android:paddingHorizontal="0dp" android:background="@android:color/transparent" android:fontFamily="@font/vazir_regular" android:textColor="@color/text_white" android:textSize="12sp" android:visibility="gone" tools:text="Full HD" tools:visibility="visible" android:maxWidth="160dp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:minWidth="0dp" android:layout_marginEnd="12dp" />
          <TextView android:id="@+id/txtLanguage" android:layout_width="wrap_content" android:layout_height="22dp" android:layout_marginStart="0dp" android:gravity="right|center_vertical" android:paddingHorizontal="0dp" android:background="@android:color/transparent" android:fontFamily="@font/vazir_regular" android:textColor="@color/text_white" android:textSize="12sp" android:visibility="gone" tools:text="فارسی" tools:visibility="visible" android:maxWidth="160dp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:minWidth="0dp" android:layout_marginEnd="12dp" />
          <TextView android:id="@+id/txtYear" android:layout_width="wrap_content" android:layout_height="22dp" android:layout_marginStart="0dp" android:minWidth="0dp" android:gravity="right|center_vertical" android:paddingHorizontal="0dp" android:background="@android:color/transparent" android:fontFamily="@font/vazir_regular" android:textColor="@color/text_white" android:textSize="12sp" tools:text="۱۹۹۱" android:includeFontPadding="false" android:layout_marginEnd="12dp" />
          <TextView android:id="@+id/txtGenres" android:layout_width="wrap_content" android:layout_height="22dp" android:layout_marginStart="0dp" android:gravity="right|center_vertical" android:paddingHorizontal="0dp" android:background="@android:color/transparent" android:fontFamily="@font/vazir_regular" android:textColor="#D3D7DE" android:textSize="12sp" tools:text="اکشن، ماجراجویی" android:maxWidth="230dp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="0dp" android:textDirection="rtl" android:includeFontPadding="false" android:layout_marginEnd="0dp" android:layout_gravity="right" />
        </LinearLayout>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:scrollbars="none" android:fillViewport="true" android:layoutDirection="rtl" android:clipChildren="false" android:clipToPadding="false" android:paddingVertical="2dp">
          <LinearLayout android:id="@+id/layoutSeasonButtonsContainer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="right|center_vertical" android:orientation="horizontal" android:layoutDirection="rtl">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnContinueSeries" android:layout_width="wrap_content" android:layout_height="40dp" android:text="ادامه تماشا" android:visibility="gone" android:background="@drawable/sl_button_high_contrast" android:textColor="@color/sl_text_high_contrast" app:backgroundTint="@null" android:backgroundTint="@null" android:stateListAnimator="@null" android:layout_marginEnd="10dp" android:fontFamily="@font/yekanbakh_bold" android:textSize="13sp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnBookmarkSeries" style="@style/Widget.MaterialComponents.Button.Icon" android:layout_width="48dp" android:layout_height="40dp" android:layout_marginEnd="10dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:background="@drawable/sl_button_high_contrast" app:backgroundTint="@null" app:cornerRadius="6dp" app:icon="@drawable/ic_bookmark" app:iconGravity="textStart" app:iconPadding="0dp" app:iconSize="20dp" app:iconTint="@color/sl_text_high_contrast" android:backgroundTint="@null" android:textColor="@color/sl_text_high_contrast" android:stateListAnimator="@null" android:insetTop="0dp" android:insetBottom="0dp" android:textSize="13sp" android:contentDescription="افزودن یا حذف از لیست من" />
          </LinearLayout>
        </HorizontalScrollView>
        <TextView android:id="@+id/txtDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:ellipsize="end" android:lineSpacingExtra="5dp" android:fontFamily="@font/vazir_regular" android:textColor="#F0F1F4" android:textSize="15sp" android:maxLines="2" tools:text="خلاصه داستان سریال..." android:gravity="right" android:textDirection="rtl" android:layout_marginEnd="0dp" android:focusable="false" android:focusableInTouchMode="false" android:clickable="false" android:longClickable="false" android:textIsSelectable="false" />
      </LinearLayout>
      <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvSeasons" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:clipToPadding="false" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" android:orientation="horizontal" android:visibility="gone" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:id="@+id/episodeSectionTitle" android:text="@string/title_episodes" android:fontFamily="@font/yekanbakh_bold" android:textColor="@color/text_white" android:textSize="18sp" />
      <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvEpisodes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:clipToPadding="false" android:paddingBottom="4dp" android:orientation="horizontal" android:paddingTop="4dp" android:clipChildren="false" android:nestedScrollingEnabled="false" />
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>