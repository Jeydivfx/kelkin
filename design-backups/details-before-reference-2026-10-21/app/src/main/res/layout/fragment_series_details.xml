<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_catalog_page" android:layoutDirection="rtl">
  <com.example.kelkin.DetailBackdropView android:id="@+id/imgBackdrop" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" tools:src="@drawable/hero_test_header" />
  <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layoutDirection="rtl" android:paddingStart="56dp" android:paddingEnd="56dp" android:layoutAnimation="@anim/detail_content_layout" android:id="@+id/detail_content" android:paddingTop="24dp" android:paddingBottom="18dp">
      <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="8dp" />
      <TextView android:id="@+id/txtTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="@color/text_white" android:textSize="34sp" android:textStyle="bold" tools:text="نام سریال" android:fontFamily="@font/yekanbakh_bold" android:maxLines="1" android:ellipsize="end" android:textDirection="rtl" android:gravity="right" />
      <TextView android:id="@+id/txtTitleEnglish" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:fontFamily="@font/montserrat_regular" android:textColor="@color/english_title_color" android:textSize="16sp" android:alpha="0.8" tools:text="Series Original Title" android:maxLines="1" android:textDirection="ltr" />
      <LinearLayout android:id="@+id/movie_info_row" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp" android:gravity="center_vertical" android:layoutDirection="rtl">
        <TextView android:id="@+id/txtRating" android:layout_width="wrap_content" android:layout_height="28dp" android:layout_marginStart="6dp" android:gravity="center" android:paddingHorizontal="10dp" android:background="@drawable/bg_hero_tag" android:fontFamily="@font/yekanbakh_bold" android:textColor="@color/text_white" android:textSize="12sp" tools:text="IMDB ۷.۳" />
        <TextView android:id="@+id/txtQuality" android:layout_width="wrap_content" android:layout_height="28dp" android:layout_marginStart="6dp" android:gravity="center" android:paddingHorizontal="10dp" android:background="@drawable/bg_hero_tag" android:fontFamily="@font/yekanbakh_bold" android:textColor="@color/text_white" android:textSize="12sp" android:visibility="gone" tools:text="Ultra HD" tools:visibility="visible" />
        <TextView android:id="@+id/txtLanguage" android:layout_width="wrap_content" android:layout_height="28dp" android:layout_marginStart="6dp" android:gravity="center" android:paddingHorizontal="10dp" android:background="@drawable/bg_hero_tag" android:fontFamily="@font/yekanbakh_bold" android:textColor="@color/text_white" android:textSize="12sp" android:visibility="gone" tools:text="فارسی" tools:visibility="visible" android:maxWidth="160dp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/txtYear" android:layout_width="wrap_content" android:layout_height="28dp" android:layout_marginStart="6dp" android:minWidth="55dp" android:gravity="center" android:paddingHorizontal="10dp" android:background="@drawable/bg_hero_tag" android:fontFamily="@font/yekanbakh_bold" android:textColor="@color/text_white" android:textSize="12sp" tools:text="۱۹۹۱" />
        <TextView android:id="@+id/txtGenres" android:layout_width="wrap_content" android:layout_height="28dp" android:layout_marginStart="6dp" android:gravity="center" android:paddingHorizontal="10dp" android:background="@drawable/bg_hero_tag" android:fontFamily="@font/yekanbakh_bold" android:textColor="@color/text_white" android:textSize="12sp" tools:text="اکشن، ماجراجویی" android:maxWidth="160dp" android:maxLines="1" android:ellipsize="end" />
      </LinearLayout>
      <TextView android:id="@+id/txtDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:ellipsize="end" android:lineSpacingExtra="3dp" android:fontFamily="@font/vazir_regular" android:textColor="#F0F1F4" android:textSize="15sp" android:maxLines="2" tools:text="خلاصه داستان سریال..." android:gravity="right" android:textDirection="rtl" android:layout_marginEnd="120dp" />
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="18dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnContinueSeries" android:layout_width="wrap_content" android:layout_height="44dp" android:text="ادامه تماشا" android:visibility="gone" android:background="@drawable/sl_button_high_contrast" android:textColor="@color/sl_text_high_contrast" app:backgroundTint="@null" android:backgroundTint="@null" android:stateListAnimator="@null" android:layout_marginEnd="10dp" android:fontFamily="@font/yekanbakh_bold" android:textSize="14sp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnBookmarkSeries" style="@style/Widget.MaterialComponents.Button.Icon" android:layout_width="48dp" android:layout_height="44dp" android:layout_marginEnd="10dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:background="@drawable/sl_button_high_contrast" app:backgroundTint="@null" app:cornerRadius="6dp" app:icon="@drawable/ic_bookmark" app:iconGravity="textStart" app:iconPadding="0dp" app:iconSize="20dp" app:iconTint="@color/sl_text_high_contrast" android:backgroundTint="@null" android:textColor="@color/sl_text_high_contrast" android:stateListAnimator="@null" android:insetTop="0dp" android:insetBottom="0dp" android:textSize="14sp" android:contentDescription="افزودن یا حذف از لیست من" />
      </LinearLayout>
      <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:scrollbars="none" android:fillViewport="true" android:layoutDirection="rtl" android:clipChildren="false" android:clipToPadding="false">
        <LinearLayout android:id="@+id/layoutSeasonButtonsContainer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="right|center_vertical" android:orientation="horizontal" android:layoutDirection="rtl"></LinearLayout>
      </HorizontalScrollView>
      <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvSeasons" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:clipToPadding="false" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" android:orientation="horizontal" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:id="@+id/episodeSectionTitle" android:text="@string/title_episodes" android:fontFamily="@font/yekanbakh_bold" android:textColor="@color/text_white" android:textSize="18sp" />
      <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvEpisodes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:clipToPadding="false" android:paddingBottom="12dp" android:orientation="horizontal" android:paddingTop="6dp" android:clipChildren="false" android:nestedScrollingEnabled="false" />
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>