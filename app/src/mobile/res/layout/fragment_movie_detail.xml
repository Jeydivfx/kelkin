<?xml version='1.0' encoding='utf-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_black" android:layoutDirection="rtl">
    <ImageView android:id="@+id/imgBackdrop" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0.4" android:scaleType="centerCrop" tools:src="@drawable/hero_test_header" />
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/hero_gradient_overlay" />
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layoutDirection="rtl" android:paddingStart="20dp" android:paddingEnd="20dp" android:layoutAnimation="@anim/layout_fall_down" android:id="@+id/detail_content" android:paddingTop="64dp" android:paddingBottom="24dp">
            <TextView android:id="@+id/txtTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="@color/text_white" android:textSize="30sp" android:textStyle="bold" tools:text="نام فیلم" />
            <TextView android:id="@+id/txtTitleEnglish" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="@font/montserrat_regular" android:textColor="@color/english_title_color" android:textSize="15sp" android:alpha="0.7" tools:text="Movie Original Title" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                <LinearLayout android:id="@+id/movie_info_row" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp" android:gravity="center_vertical" android:layoutDirection="rtl">
                    <TextView android:id="@+id/txtRating" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="8dp" android:gravity="center" android:paddingHorizontal="12dp" android:background="@drawable/bg_hero_tag" android:fontFamily="@font/yekanbakh_bold" android:textColor="@color/text_white" android:textSize="12sp" tools:text="IMDB ۷.۳" />
                    <TextView android:id="@+id/txtQuality" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="8dp" android:gravity="center" android:paddingHorizontal="12dp" android:background="@drawable/bg_hero_tag" android:fontFamily="@font/yekanbakh_bold" android:textColor="@color/text_white" android:textSize="12sp" android:visibility="gone" tools:text="Ultra HD" tools:visibility="visible" />
                    <TextView android:id="@+id/txtLanguage" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="8dp" android:gravity="center" android:paddingHorizontal="12dp" android:background="@drawable/bg_hero_tag" android:fontFamily="@font/yekanbakh_bold" android:textColor="@color/text_white" android:textSize="12sp" android:visibility="gone" tools:text="فارسی" tools:visibility="visible" />
                    <TextView android:id="@+id/txtYear" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="8dp" android:minWidth="55dp" android:gravity="center" android:paddingHorizontal="10dp" android:background="@drawable/bg_hero_tag" android:fontFamily="@font/yekanbakh_bold" android:textColor="@color/text_white" android:textSize="12sp" tools:text="۱۹۹۱" />
                    <TextView android:id="@+id/txtGenres" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="8dp" android:gravity="center" android:paddingHorizontal="16dp" android:background="@drawable/bg_hero_tag" android:fontFamily="@font/yekanbakh_bold" android:textColor="@color/text_white" android:textSize="12sp" tools:text="اکشن، ماجراجویی" />
                </LinearLayout>
            </HorizontalScrollView>
            <TextView android:id="@+id/txtDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:ellipsize="end" android:lineSpacingExtra="6dp" android:fontFamily="@font/vazir_regular" android:textColor="@color/text_white" android:textSize="15sp" android:maxLines="2" tools:text="خلاصه داستان..." />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center_vertical" android:orientation="vertical" android:layout_gravity="right">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnContinue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:minHeight="48dp" android:minWidth="0dp" android:nextFocusUp="@id/btnPlay" android:paddingHorizontal="16dp" android:background="@drawable/sl_button_high_contrast" app:backgroundTint="@null" android:fontFamily="@font/yekanbakh_bold" android:text="@string/btn_continue_watch" android:textColor="@color/sl_text_high_contrast" android:textSize="16sp" app:cornerRadius="6dp" app:iconSize="20dp" android:visibility="gone" tools:visibility="visible" android:backgroundTint="@null" android:stateListAnimator="@null" app:iconTint="@color/sl_text_high_contrast" android:layout_marginBottom="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layoutDirection="rtl">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnPlay" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:nextFocusUp="@id/btnPlay" android:layout_marginEnd="4dp" android:minWidth="0dp" android:paddingHorizontal="20dp" android:background="@drawable/sl_button_high_contrast" app:backgroundTint="@null" android:fontFamily="@font/yekanbakh_bold" android:text="@string/btn_play" android:textColor="@color/sl_text_high_contrast" android:textSize="16sp" app:cornerRadius="6dp" app:icon="@drawable/ic_media_play" app:iconGravity="textEnd" app:iconSize="20dp" app:iconTint="@color/sl_text_high_contrast" android:backgroundTint="@null" android:stateListAnimator="@null" android:layout_weight="1" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnBookmark" style="@style/Widget.MaterialComponents.Button.Icon" android:layout_width="48dp" android:layout_height="wrap_content" android:nextFocusUp="@id/btnBookmark" android:layout_marginEnd="4dp" android:minWidth="0dp" android:minHeight="48dp" android:padding="0dp" android:background="@drawable/sl_button_high_contrast" app:backgroundTint="@null" app:cornerRadius="6dp" app:icon="@drawable/ic_bookmark" app:iconGravity="textStart" app:iconPadding="0dp" app:iconSize="20dp" app:iconTint="@color/sl_text_high_contrast" android:backgroundTint="@null" android:textColor="@color/sl_text_high_contrast" android:stateListAnimator="@null" android:contentDescription="افزودن یا حذف از لیست من" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:text="@string/title_cast" android:textColor="@color/text_white" android:textSize="22sp" android:textStyle="bold" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvCast" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:clipToPadding="false" android:paddingBottom="10dp" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>