<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_black" android:layoutDirection="rtl">
  <ImageView android:id="@+id/imgBackdrop" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0.4" android:scaleType="centerCrop" tools:src="@drawable/hero_test_header" />
  <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/hero_gradient_overlay" />
  <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layoutDirection="rtl" android:paddingStart="20dp" android:paddingEnd="20dp" android:layoutAnimation="@anim/layout_fall_down" android:id="@+id/detail_content" android:paddingTop="64dp" android:paddingBottom="24dp">
      <TextView android:id="@+id/txtTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="@color/text_white" android:textSize="30sp" android:textStyle="bold" tools:text="نام سریال" />
      <TextView android:id="@+id/txtTitleEnglish" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="@font/montserrat_regular" android:textColor="@color/english_title_color" android:textSize="15sp" android:alpha="0.7" tools:text="Series Original Title" />
      <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
        <LinearLayout android:id="@+id/movie_info_row" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp" android:gravity="center_vertical" android:layoutDirection="rtl">
          <TextView android:id="@+id/txtRating" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="8dp" android:gravity="center" android:paddingHorizontal="12dp" android:background="@drawable/bg_hero_tag" android:fontFamily="@font/yekanbakh_bold" android:textColor="@color/text_white" android:textSize="12sp" tools:text="IMDB ۷.۳" />
          <TextView android:id="@+id/txtQuality" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="8dp" android:gravity="center" android:paddingHorizontal="12dp" android:background="@drawable/bg_hero_tag" android:fontFamily="@font/yekanbakh_bold" android:textColor="@color/text_white" android:textSize="12sp" android:visibility="gone" tools:text="Full HD" tools:visibility="visible" />
          <TextView android:id="@+id/txtLanguage" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="8dp" android:gravity="center" android:paddingHorizontal="12dp" android:background="@drawable/bg_hero_tag" android:fontFamily="@font/yekanbakh_bold" android:textColor="@color/text_white" android:textSize="12sp" android:visibility="gone" tools:text="فارسی" tools:visibility="visible" />
          <TextView android:id="@+id/txtYear" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="8dp" android:minWidth="55dp" android:gravity="center" android:paddingHorizontal="10dp" android:background="@drawable/bg_hero_tag" android:fontFamily="@font/yekanbakh_bold" android:textColor="@color/text_white" android:textSize="12sp" tools:text="۱۹۹۱" />
          <TextView android:id="@+id/txtGenres" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="0dp" android:gravity="right|center_vertical" android:paddingHorizontal="0dp" android:background="@android:color/transparent" android:fontFamily="@font/yekanbakh_bold" android:textColor="@color/text_white" android:textSize="12sp" tools:text="اکشن، ماجراجویی" android:layout_marginTop="0dp" android:maxWidth="230dp" android:maxLines="1" android:ellipsize="end" android:layout_marginEnd="0dp" android:layout_gravity="right" />
        </LinearLayout>
      </HorizontalScrollView>
      <TextView android:id="@+id/txtDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:ellipsize="end" android:lineSpacingExtra="6dp" android:fontFamily="@font/vazir_regular" android:textColor="@color/text_white" android:textSize="15sp" android:maxLines="2" tools:text="خلاصه داستان سریال..." android:focusable="false" android:focusableInTouchMode="false" android:clickable="false" android:longClickable="false" android:textIsSelectable="false" />
      <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:scrollbars="none" android:fillViewport="true" android:layoutDirection="rtl">
        <LinearLayout android:id="@+id/layoutSeasonButtonsContainer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="right|center_vertical" android:orientation="horizontal" android:layoutDirection="rtl">
          <com.google.android.material.button.MaterialButton android:id="@+id/btnContinueSeries" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ادامه تماشا" android:visibility="gone" android:background="@drawable/sl_button_high_contrast" android:textColor="@color/sl_text_high_contrast" app:backgroundTint="@null" android:backgroundTint="@null" android:stateListAnimator="@null" android:layout_marginEnd="8dp" android:fontFamily="@font/yekanbakh_bold" android:textSize="14sp" android:minHeight="48dp" android:insetTop="0dp" android:insetBottom="0dp" />
          <com.google.android.material.button.MaterialButton android:id="@+id/btnBookmarkSeries" style="@style/Widget.MaterialComponents.Button.Icon" android:layout_width="48dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:minWidth="0dp" android:minHeight="48dp" android:padding="0dp" android:background="@drawable/sl_button_high_contrast" app:backgroundTint="@null" app:cornerRadius="6dp" app:icon="@drawable/ic_bookmark" app:iconGravity="textStart" app:iconPadding="0dp" app:iconSize="20dp" app:iconTint="@color/sl_text_high_contrast" android:backgroundTint="@null" android:textColor="@color/sl_text_high_contrast" android:stateListAnimator="@null" android:contentDescription="افزودن یا حذف از لیست من" />
        </LinearLayout>
      </HorizontalScrollView>
      <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvSeasons" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:clipToPadding="false" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" android:orientation="horizontal" android:nestedScrollingEnabled="false" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:id="@+id/episodeSectionTitle" android:text="@string/title_episodes" android:fontFamily="@font/yekanbakh_bold" android:textColor="@color/text_white" android:textSize="18sp" />
      <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvEpisodes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:clipToPadding="false" android:paddingBottom="30dp" android:orientation="horizontal" android:nestedScrollingEnabled="false" />
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>