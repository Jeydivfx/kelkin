<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@drawable/bg_gradient_main">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layoutDirection="rtl" android:background="@drawable/bg_gradient_main" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="KELKIN / ADMIN" android:textColor="@color/yellow" android:textSize="13sp" android:gravity="right" android:fontFamily="@font/yekanbakh_bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="مدیریت آرشیو" android:textColor="@color/text_white" android:textSize="32sp" android:fontFamily="@font/yekanbakh_bold" android:gravity="right" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="برای افزودن، ویرایش یا حذف محتوا، یک بخش را انتخاب کنید." android:textColor="@color/text_gray" android:textSize="16sp" android:fontFamily="@font/yekanbakh_regular" android:gravity="right" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:orientation="vertical">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnManageMovies" android:layout_width="match_parent" android:layout_weight="0" android:layout_height="wrap_content" android:layout_margin="8dp" android:text="فیلم‌ها" android:textSize="22sp" app:icon="@drawable/ic_menu_movie" app:iconGravity="textTop" app:iconSize="40dp" app:iconPadding="20dp" app:iconTint="@color/sl_text_high_contrast" android:background="@drawable/sl_button_high_contrast" android:backgroundTint="@null" app:backgroundTint="@null" android:textColor="@color/sl_text_high_contrast" android:fontFamily="@font/yekanbakh_bold" android:stateListAnimator="@null" android:focusable="true" android:layout_marginTop="8dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnManageSeries" android:layout_width="match_parent" android:layout_weight="0" android:layout_height="wrap_content" android:layout_margin="8dp" android:text="سریال‌ها" android:textSize="22sp" app:icon="@drawable/ic_series" app:iconGravity="textTop" app:iconSize="40dp" app:iconPadding="20dp" app:iconTint="@color/sl_text_high_contrast" android:background="@drawable/sl_button_high_contrast" android:backgroundTint="@null" app:backgroundTint="@null" android:textColor="@color/sl_text_high_contrast" android:fontFamily="@font/yekanbakh_bold" android:stateListAnimator="@null" android:focusable="true" android:layout_marginTop="8dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnManageTV" android:layout_width="match_parent" android:layout_weight="0" android:layout_height="wrap_content" android:layout_margin="8dp" android:text="تلویزیون زنده" android:textSize="22sp" app:icon="@drawable/ic_menu_tv" app:iconGravity="textTop" app:iconSize="40dp" app:iconPadding="20dp" app:iconTint="@color/sl_text_high_contrast" android:background="@drawable/sl_button_high_contrast" android:backgroundTint="@null" app:backgroundTint="@null" android:textColor="@color/sl_text_high_contrast" android:fontFamily="@font/yekanbakh_bold" android:stateListAnimator="@null" android:focusable="true" android:layout_marginTop="8dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="right">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAdminBack" android:layout_width="180dp" android:layout_height="wrap_content" android:text="بازگشت به تنظیمات" android:background="@drawable/sl_button_high_contrast" android:backgroundTint="@null" app:backgroundTint="@null" android:textColor="@color/sl_text_high_contrast" android:fontFamily="@font/yekanbakh_bold" android:stateListAnimator="@null" android:focusable="true" android:minHeight="48dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAdminSignOut" android:layout_width="180dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="خروج از مدیریت" android:background="@drawable/sl_button_high_contrast" android:backgroundTint="@null" app:backgroundTint="@null" android:textColor="@color/sl_text_high_contrast" android:fontFamily="@font/yekanbakh_bold" android:stateListAnimator="@null" android:focusable="true" android:minHeight="48dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>