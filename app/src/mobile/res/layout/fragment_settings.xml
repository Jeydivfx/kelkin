<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:layoutDirection="rtl" android:background="@drawable/bg_catalog_page">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تنظیمات" android:textSize="32sp" android:textColor="@color/text_white" android:fontFamily="@font/yekanbakh_bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="تجربهٔ تماشا را به سلیقهٔ خود تنظیم کنید." android:textColor="@color/text_gray" android:textSize="16sp" android:fontFamily="@font/yekanbakh_regular" />
    <ScrollView android:id="@+id/settingsScrollView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="28dp" android:fillViewport="true" android:focusable="false">
        <LinearLayout android:id="@+id/settingsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:baselineAligned="false">
            <LinearLayout android:layout_width="match_parent" android:layout_weight="0" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="زیرنویس" android:textColor="@color/yellow" android:textSize="20sp" android:fontFamily="@font/yekanbakh_bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginBottom="18dp" android:text="خوانایی متناسب با تماشای شما" android:textColor="@color/text_gray" android:textSize="13sp" android:fontFamily="@font/yekanbakh_regular" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_admin_surface" android:padding="6dp" android:orientation="vertical">
                    <LinearLayout android:id="@+id/cardSubtitleSize" android:layout_width="match_parent" android:layout_height="90dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:background="@drawable/bg_settings_row" android:focusable="true" android:clickable="true" android:descendantFocusability="blocksDescendants">
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:duplicateParentState="true">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="اندازهٔ متن" android:textColor="@color/sl_text_high_contrast" android:textSize="18sp" android:fontFamily="@font/yekanbakh_bold" android:duplicateParentState="true" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="تغییر اندازهٔ زیرنویس" android:textColor="@color/sl_text_high_contrast" android:textSize="12sp" android:fontFamily="@font/yekanbakh_regular" android:duplicateParentState="true" />
                        </LinearLayout>
                        <TextView android:id="@+id/txtSubtitleSizeValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/sl_text_high_contrast" android:textSize="15sp" android:duplicateParentState="true" android:fontFamily="@font/yekanbakh_bold" android:layout_marginStart="12dp" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="14dp" android:background="#383838" />
                    <LinearLayout android:id="@+id/cardSubtitleColor" android:layout_width="match_parent" android:layout_height="90dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:background="@drawable/bg_settings_row" android:focusable="true" android:clickable="true" android:descendantFocusability="blocksDescendants">
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:duplicateParentState="true">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="رنگ متن" android:textColor="@color/sl_text_high_contrast" android:textSize="18sp" android:fontFamily="@font/yekanbakh_bold" android:duplicateParentState="true" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="انتخاب رنگ زیرنویس" android:textColor="@color/sl_text_high_contrast" android:textSize="12sp" android:fontFamily="@font/yekanbakh_regular" android:duplicateParentState="true" />
                        </LinearLayout>
                        <TextView android:id="@+id/txtSubtitleColorValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/sl_text_high_contrast" android:textSize="15sp" android:duplicateParentState="true" android:fontFamily="@font/yekanbakh_bold" android:layout_marginStart="12dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_weight="0" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="32dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="برنامه" android:textColor="@color/yellow" android:textSize="20sp" android:fontFamily="@font/yekanbakh_bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginBottom="18dp" android:text="به‌روزرسانی و نگهداری" android:textColor="@color/text_gray" android:textSize="13sp" android:fontFamily="@font/yekanbakh_regular" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_admin_surface" android:padding="6dp" android:orientation="vertical">
                    <LinearLayout android:id="@+id/cardAppUpdate" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="90dp" android:orientation="vertical" android:gravity="center_vertical" android:padding="14dp" android:background="@drawable/bg_settings_row" android:focusable="true" android:clickable="true" android:descendantFocusability="blocksDescendants">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="به‌روزرسانی برنامه" android:textColor="@color/sl_text_high_contrast" android:textSize="18sp" android:fontFamily="@font/yekanbakh_bold" android:duplicateParentState="true"/>
<TextView android:id="@+id/txtAppUpdateStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="بررسی نسخهٔ جدید" android:textColor="@color/sl_text_high_contrast" android:textSize="12sp" android:fontFamily="@font/yekanbakh_regular" android:duplicateParentState="true"/>
</LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="14dp" android:background="#383838" />
                    <LinearLayout android:id="@+id/cardClearCache" android:layout_width="match_parent" android:layout_height="90dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:background="@drawable/bg_settings_row" android:focusable="true" android:clickable="true" android:descendantFocusability="blocksDescendants">
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:duplicateParentState="true">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="پاک‌سازی حافظه" android:textColor="@color/sl_text_high_contrast" android:textSize="18sp" android:fontFamily="@font/yekanbakh_bold" android:duplicateParentState="true" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="حذف تصاویر ذخیره‌شدهٔ موقت" android:textColor="@color/sl_text_high_contrast" android:textSize="12sp" android:fontFamily="@font/yekanbakh_regular" android:duplicateParentState="true" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_weight="0" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="32dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="حساب و مدیریت" android:textColor="@color/yellow" android:textSize="20sp" android:fontFamily="@font/yekanbakh_bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginBottom="18dp" android:text="دسترسی و ورود" android:textColor="@color/text_gray" android:textSize="13sp" android:fontFamily="@font/yekanbakh_regular" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_admin_surface" android:padding="6dp" android:orientation="vertical">
                    <LinearLayout android:id="@+id/adminSignInAction" android:layout_width="match_parent" android:layout_height="90dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:background="@drawable/bg_settings_row" android:focusable="true" android:clickable="true" android:descendantFocusability="blocksDescendants">
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:duplicateParentState="true">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ورود مدیر" android:textColor="@color/sl_text_high_contrast" android:textSize="18sp" android:fontFamily="@font/yekanbakh_bold" android:duplicateParentState="true" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="مدیریت فیلم، سریال و کانال" android:textColor="@color/sl_text_high_contrast" android:textSize="12sp" android:fontFamily="@font/yekanbakh_regular" android:duplicateParentState="true" />
                        </LinearLayout>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="14dp" android:background="#383838" />
                    <LinearLayout android:id="@+id/accountSignOutAction" android:layout_width="match_parent" android:layout_height="90dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:background="@drawable/bg_settings_row" android:focusable="true" android:clickable="true" android:descendantFocusability="blocksDescendants">
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:duplicateParentState="true">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="خروج از حساب" android:textColor="@color/sl_text_high_contrast" android:textSize="18sp" android:fontFamily="@font/yekanbakh_bold" android:duplicateParentState="true" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="ورود با حساب دیگری" android:textColor="@color/sl_text_high_contrast" android:textSize="12sp" android:fontFamily="@font/yekanbakh_regular" android:duplicateParentState="true" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>