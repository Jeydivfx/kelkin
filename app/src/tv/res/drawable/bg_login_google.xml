    <item android:state_pressed="true"><shape><solid android:color="#EBCB23"/><corners android:radius="9dp"/></shape></item>
    <item android:state_focused="true"><shape><solid android:color="#FFDF29"/><corners android:radius="9dp"/></shape></item>
    <item><shape><solid android:color="#D9252D39"/><corners android:radius="9dp"/><stroke android:width="1dp" android:color="#425060"/></shape></item>
