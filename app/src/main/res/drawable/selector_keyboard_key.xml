<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/yellow" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/yellow" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="@color/dialog_background"
                android:centerColor="@color/dialog_background"
                android:endColor="@color/bg_black" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="@color/card_stroke_default" />
        </shape>
    </item>
</selector>