<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@drawable/card_selector"
    android:focusable="true"
    android:clickable="true"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/imgMoviePoster"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_alignBottom="@id/imgMoviePoster"
            android:background="@drawable/gradient_bottom" />

        <TextView
            android:id="@+id/txtMovieTitleGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@id/imgMoviePoster"
            android:fontFamily="@font/yekanbakh_bold"
            android:padding="10dp"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end" />


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/imdb_badge_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="3dp"
                android:src="@drawable/ic_star"
                app:tint="@color/yellow" />

            <TextView
                android:id="@+id/txtImdbRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_regular"
                android:includeFontPadding="false"
                android:textColor="@color/text_white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:text="@string/default_imdb_rating" />
        </LinearLayout>


    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>