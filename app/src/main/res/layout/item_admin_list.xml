<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:background="@drawable/bg_admin_surface" android:padding="16dp" android:orientation="horizontal" android:gravity="center_vertical" android:layoutDirection="rtl">
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="20dp">
<TextView android:id="@+id/txtTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_white" android:textSize="20sp" android:fontFamily="@font/yekanbakh_bold" android:maxLines="2" android:ellipsize="end"/>
<TextView android:id="@+id/txtMetadata" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/text_gray" android:textSize="13sp" android:fontFamily="@font/yekanbakh_regular"/>
</LinearLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/btnEdit" android:layout_width="100dp" android:layout_height="48dp" android:text="ویرایش" android:background="@drawable/sl_button_high_contrast" android:backgroundTint="@null" app:backgroundTint="@null" android:textColor="@color/sl_text_high_contrast" android:fontFamily="@font/yekanbakh_bold" android:stateListAnimator="@null" android:focusable="true"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnDelete" android:layout_width="100dp" android:layout_height="48dp" android:layout_marginStart="12dp" android:text="حذف" android:background="@drawable/sl_button_high_contrast" android:backgroundTint="@null" app:backgroundTint="@null" android:textColor="@color/sl_text_high_contrast" android:fontFamily="@font/yekanbakh_bold" android:stateListAnimator="@null" android:focusable="true"/>
</LinearLayout>