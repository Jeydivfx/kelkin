<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:background="@drawable/bg_gradient_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp">

        <TextView
            android:id="@+id/txtGeneratedId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/label_generated_movie_id"
            android:textColor="@color/yellow"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtNameFa"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@color/dialog_background"
            android:hint="@string/hint_movie_name_fa"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_gray"
            android:textSize="15sp"
            android:textDirection="rtl" />

        <EditText
            android:id="@+id/edtDescFa"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@color/dialog_background"
            android:hint="@string/hint_movie_desc_fa"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_gray"
            android:textSize="15sp"
            android:textDirection="rtl" />

        <TextView
            android:id="@+id/btnCategoryDropdown"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@color/dialog_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical|right"
            android:hint="@string/hint_select_movie_category"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_gray"
            android:textSize="15sp"
            android:textDirection="rtl" />

        <!-- دکمه کشویی انتخاب زبان -->
        <TextView
            android:id="@+id/btnLanguageDropdown"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@color/dialog_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical|right"
            android:hint="انتخاب زبان"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_gray"
            android:textSize="15sp"
            android:textDirection="rtl" />

        <!-- دکمه کشویی انتخاب کیفیت -->
        <TextView
            android:id="@+id/btnQualityDropdown"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@color/dialog_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical|right"
            android:hint="انتخاب کیفیت"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_gray"
            android:textSize="15sp"
            android:textDirection="rtl" />

        <EditText
            android:id="@+id/edtTmdbId"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@color/dialog_background"
            android:hint="@string/hint_tmdb_id"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_gray"
            android:textSize="15sp"
            android:textDirection="rtl" />

        <EditText
            android:id="@+id/edtUrl1"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/dialog_background"
            android:hint="@string/hint_video_url"
            android:inputType="textUri"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_gray"
            android:textSize="15sp"
            android:textDirection="rtl" />

    </LinearLayout>
</ScrollView>