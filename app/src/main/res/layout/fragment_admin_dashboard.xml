<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_gradient_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="40dp"
        android:paddingVertical="30dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="پنل مدیریت کلکین"
            android:textColor="#FFD700"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="30dp" />

        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:columnOrderPreserved="false"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageMovies"
                android:layout_width="160dp"
                android:layout_height="120dp"
                android:layout_margin="12dp"
                android:text="مدیریت فیلم‌ها"
                android:textSize="15sp"
                android:fontFamily="@font/yekanbakh_bold"
                android:background="@drawable/sl_button_high_contrast"
                app:backgroundTint="@null"
                android:textColor="@drawable/sl_text_high_contrast"
                app:icon="@drawable/ic_menu_movie"
                app:iconGravity="textTop"
                app:iconSize="36dp"
                app:iconTint="@drawable/sl_text_high_contrast"
                app:cornerRadius="12dp"
                style="@style/AdminButtonStyle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageSeries"
                android:layout_width="160dp"
                android:layout_height="120dp"
                android:layout_margin="12dp"
                android:text="مدیریت سریال ها"
                android:textSize="15sp"
                android:fontFamily="@font/yekanbakh_bold"
                android:background="@drawable/sl_button_high_contrast"
                app:backgroundTint="@null"
                android:textColor="@drawable/sl_text_high_contrast"
                app:icon="@drawable/ic_series"
                app:iconGravity="textTop"
                app:iconSize="36dp"
                app:iconTint="@drawable/sl_text_high_contrast"
                app:cornerRadius="12dp"
                style="@style/AdminButtonStyle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageTV"
                android:layout_width="160dp"
                android:layout_height="120dp"
                android:layout_margin="12dp"
                android:text="مدیریت شبکه‌ها"
                android:textSize="15sp"
                android:fontFamily="@font/yekanbakh_bold"
                android:background="@drawable/sl_button_high_contrast"
                android:textColor="@drawable/sl_text_high_contrast"
                app:icon="@drawable/ic_menu_tv"
                app:iconGravity="textTop"
                app:iconSize="36dp"
                app:backgroundTint="@null"
                app:iconTint="@drawable/sl_text_high_contrast"
                app:cornerRadius="12dp"
                style="@style/AdminButtonStyle" />

        </GridLayout>

    </LinearLayout>
</ScrollView>