<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="420dp"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/dialog_background"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:layoutDirection="rtl">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/admin_panel_title"
        android:textColor="@color/text_white"
        android:fontFamily="@font/yekanbakh_bold"
        android:textSize="22sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtAdminUsername"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:hint="ایمیل مدیر"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_gray"
        android:fontFamily="@font/yekanbakh_regular"
        android:textSize="16sp"
        android:paddingHorizontal="16dp"
        android:inputType="textEmailAddress"
        android:gravity="right|center_vertical"
        android:textAlignment="gravity"
        android:focusable="true" />

    <EditText
        android:id="@+id/edtAdminPassword"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:hint="@string/admin_hint_password"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_gray"
        android:fontFamily="@font/yekanbakh_regular"
        android:textSize="16sp"
        android:paddingHorizontal="16dp"
        android:inputType="textPassword"
        android:gravity="right|center_vertical"
        android:textAlignment="gravity"
        android:focusable="true" />

    <TextView
        android:id="@+id/txtAdminLoginStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#FFB4AB"
        android:textSize="15sp"
        android:fontFamily="@font/yekanbakh_regular"
        android:gravity="center"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="horizontal"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdminLogin"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:background="@drawable/sl_button_high_contrast"
            app:backgroundTint="@null"
            android:fontFamily="@font/yekanbakh_bold"
            android:text="@string/admin_btn_login"
            android:textColor="@color/sl_text_high_contrast"
            android:textSize="18sp"
            app:cornerRadius="6dp"
            android:focusable="true"  android:backgroundTint="@null" android:stateListAnimator="@null" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdminCancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:background="@drawable/sl_button_high_contrast"
            app:backgroundTint="@null"
            android:fontFamily="@font/yekanbakh_bold"
            android:text="@string/admin_btn_cancel"
            android:textColor="@color/sl_text_high_contrast"
            android:textSize="18sp"
            app:cornerRadius="6dp"
            android:focusable="true"  android:backgroundTint="@null" android:stateListAnimator="@null" />
    </LinearLayout>
</LinearLayout>
