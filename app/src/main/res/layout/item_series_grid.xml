<?xml version='1.0' encoding='utf-8'?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="0dp" android:focusable="true" android:clickable="true" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:cardBackgroundColor="#191B20" app:strokeWidth="1dp" app:strokeColor="#30333B">
    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <ImageView android:id="@+id/imgSeriesPoster" android:layout_width="match_parent" android:layout_height="220dp" android:scaleType="centerCrop" />
        <View android:layout_width="match_parent" android:layout_height="110dp" android:layout_alignBottom="@id/imgSeriesPoster" android:background="@drawable/gradient_bottom" />
        <TextView android:id="@+id/txtSeriesTitleGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignBottom="@id/imgSeriesPoster" android:fontFamily="@font/yekanbakh_bold" android:padding="12dp" android:textColor="@color/text_white" android:textSize="14sp" android:gravity="right" android:maxLines="1" android:ellipsize="end" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginStart="8dp" android:background="@drawable/imdb_badge_background" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="6dp" android:paddingVertical="3dp">
            <ImageView android:layout_width="12dp" android:layout_height="12dp" android:layout_marginStart="3dp" android:src="@drawable/ic_star" app:tint="@color/yellow" />
            <TextView android:id="@+id/txtImdbRating" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/montserrat_regular" android:includeFontPadding="false" android:textColor="@color/text_white" android:textSize="11sp" android:textStyle="bold" android:text="7.8" />
        </LinearLayout>
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>