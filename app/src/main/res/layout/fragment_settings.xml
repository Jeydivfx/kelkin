<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_main"
    android:layoutDirection="rtl"
    android:textDirection="rtl">

    <ScrollView
        android:id="@+id/settingsScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:focusable="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/settingsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:paddingVertical="40dp"
            android:focusable="false"
            android:descendantFocusability="afterDescendants"
            android:gravity="center_horizontal">

            <TextView
                style="@style/SettingHeader"
                android:layout_width="340dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/settings_header_support"
                android:textColor="@color/settings_header_color"
                android:textSize="14sp"
                android:gravity="right" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cardAbout"
                android:layout_width="340dp"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingHorizontal="16dp"
                android:background="@drawable/sl_button_high_contrast"
                app:backgroundTint="@null"
                android:fontFamily="@font/yekanbakh_bold"
                android:text="@string/settings_btn_about"
                android:textColor="@drawable/sl_text_high_contrast"
                android:textSize="15sp"
                app:cornerRadius="6dp"
                android:gravity="center_vertical|right"
                android:focusable="true"
                android:clickable="true"
                android:elevation="0dp"
                app:elevation="0dp"
                android:nextFocusUp="@id/cardAbout"
                android:nextFocusDown="@id/cardClearCache" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cardClearCache"
                android:layout_width="340dp"
                android:layout_height="56dp"
                android:layout_marginBottom="24dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingHorizontal="16dp"
                android:background="@drawable/sl_button_high_contrast"
                app:backgroundTint="@null"
                android:fontFamily="@font/yekanbakh_bold"
                android:text="@string/settings_btn_clear_cache"
                android:textColor="@drawable/sl_text_high_contrast"
                android:textSize="15sp"
                app:cornerRadius="6dp"
                android:gravity="center_vertical|right"
                android:focusable="true"
                android:clickable="true"
                android:elevation="0dp"
                app:elevation="0dp"
                android:nextFocusUp="@id/cardAbout"
                android:nextFocusDown="@id/cardClearCache" />

            <View
                android:layout_width="340dp"
                android:layout_height="1dp"
                android:background="@color/settings_divider_color"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/txtAppVersion"
                android:layout_width="340dp"
                android:layout_height="wrap_content"
                android:text="@string/settings_app_version"
                android:textColor="@color/settings_version_color"
                android:textSize="12sp"
                android:gravity="right" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>